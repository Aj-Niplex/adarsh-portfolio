# Two services are built from this repo.
# Public site: set only API_ORIGIN (the address of the API service). It holds no secrets.
# API service: set SERVICE_ROLE=api and SITE_HOSTS=<the public site's host>, plus everything below.
# Local development: leave all of these empty and everything runs in one process.
API_ORIGIN=
SERVICE_ROLE=
SITE_HOSTS=

# Server-only Gemini API key. Never use NEXT_PUBLIC_ for this.
GEMINI_API_KEY=
# Optional override; default: gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
# Visit counter (server-only). Without both, the counter is hidden.
VIEWS_ENDPOINT=
VIEWS_SECRET=
# Optional chat settings
CHAT_DAILY_CAP=400

# Sign-in with an emailed code (needs ALL of these: the signing secret, the store above, and one mail provider).
# Without a mail provider the "Sign in" option stays hidden and the chat stays on the 2-a-minute limit.
CHAT_SIGNING_SECRET=
# Pick ONE provider:
# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# Resend (also set MAIL_FROM, for example "AJ NiPlex <codes@your-domain.com>")
RESEND_API_KEY=
# Brevo (also set MAIL_FROM)
BREVO_API_KEY=
MAIL_FROM=
