# The public site holds no secrets. It only needs to know where the API service is.
# Leave API_ORIGIN empty for plain local development (the assistant and forms are then absent).
# The address of the API service, for example https://aj-niplex-api.vercel.app
API_ORIGIN=
# Shared with the API service. The public site writes the visitor's address and location into signed
# headers when it forwards a call, because Vercel replaces them with its own on the way.
EDGE_KEY=

# Optional: ownership codes for Google Search Console and Bing Webmaster Tools (the content value of their HTML tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
