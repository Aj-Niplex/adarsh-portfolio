 {
  "id": "tool.create_skill",
  "title": "Create a skill",
  "summary": "Saves a new Markdown skill.",
  "status": "merged",
  "since": "2026-09-02",
  "see_also": [
   "group.skills"
  ],
  "search_terms": [
   "create_skill",
   "create a skill"
  ],
  "name": "create_skill",
  "group": "skills",
  "description": "Content over 15,000 characters or with injection-like text is rejected.",
  "parameters": [
   {
    "name": "name",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "A short name.",
    "limits": null
   },
   {
    "name": "content",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "The text to store or write.",
    "limits": "Memory notes are read back into prompts in slices of 4,000 characters (global) or 1,500 (session)."
   },
   {
    "name": "use_case",
    "type": "string",
    "required": false,
    "default": null,
    "meaning": "One line about when to use the skill.",
    "limits": null
   },
   {
    "name": "category",
    "type": "string",
    "required": false,
    "default": "personal",
    "meaning": "Which group of skills or tools.",
    "limits": "One of: personal, market, custom."
   }
  ],
  "returns": "A confirmation.",
  "example": {
   "synthetic": true,
   "call": {
    "name": "demo",
    "content": "demo"
   },
   "result": "Created personal/deploy-checklist"
  },
  "risk": "low",
  "needs_approval": "never",
  "approval_rule": "No approval.",
  "allowed_in_scheduled_jobs": false,
  "side_effects": [
   "Writes a file under skills/library."
  ],
  "failure_modes": [
   {
    "when": "Too long",
    "what_the_agent_sees": "Rejected with the limit"
   },
   {
    "when": "Flagged text",
    "what_the_agent_sees": "Rejected with the reason"
   }
  ],
  "default_state": "on"
 },
