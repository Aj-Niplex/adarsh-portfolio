  "since": "2026-09-02",
  "see_also": [
   "group.files"
  ],
  "search_terms": [
   "create_file",
   "create a file"
  ],
  "name": "create_file",
  "group": "files",
  "description": "Refuses protected paths and root files.",
  "parameters": [
   {
    "name": "path",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "Path relative to the project, such as vault/note.md.",
    "limits": null
   },
   {
    "name": "content",
    "type": "string",
    "required": false,
    "default": null,
    "meaning": "The text to store or write.",
    "limits": "Memory notes are read back into prompts in slices of 4,000 characters (global) or 1,500 (session)."
   }
  ],
  "returns": "A confirmation.",
  "example": {
   "synthetic": true,
   "call": {
    "path": "demo"
   },
   "result": "Created vault/notes/a.md"
  },
  "risk": "low",
  "needs_approval": "never",
  "approval_rule": "No approval. Hard blocks apply.",
  "allowed_in_scheduled_jobs": false,
  "side_effects": [
   "Writes a file."
  ],
  "failure_modes": [
   {
    "when": "Root file",
    "what_the_agent_sees": "Refused: root files cannot be edited by the agent."
   },
   {
    "when": "Protected path",
    "what_the_agent_sees": "HARD BLOCK: harness core cannot be written"
   }
  ],
  "default_state": "on"
 },
