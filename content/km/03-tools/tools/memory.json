[
 {
  "id": "tool.save_memory",
  "title": "Save a note",
  "summary": "Saves a Markdown note to global or session memory.",
  "status": "merged",
  "since": "2026-09-02",
  "see_also": [
   "group.memory"
  ],
  "search_terms": [
   "save_memory",
   "save a note"
  ],
  "name": "save_memory",
  "group": "memory",
  "description": "Writes a note with a title, optional tags and the text. Global notes are shared by all chats. Session notes belong to one chat.",
  "parameters": [
   {
    "name": "content",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "The text to store or write.",
    "limits": "Memory notes are read back into prompts in slices of 4,000 characters (global) or 1,500 (session)."
   },
   {
    "name": "title",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "A short title for the note.",
    "limits": "Cut to 200 characters for notifications."
   },
   {
    "name": "scope",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "Where the note lives: global (all chats) or session (this chat).",
    "limits": "One of: global, session."
   },
   {
    "name": "tags",
    "type": "array",
    "required": false,
    "default": null,
    "meaning": "Optional labels.",
    "limits": null
   }
  ],
  "returns": "A confirmation with the saved path.",
  "example": {
   "synthetic": true,
   "call": {
    "content": "demo",
    "title": "demo",
    "scope": "global"
   },
   "result": "Saved note 'deploy-notes' to global."
  },
  "risk": "low",
  "needs_approval": "never",
  "approval_rule": "No approval. Writes inside the memory folder only.",
  "allowed_in_scheduled_jobs": false,
  "side_effects": [
   "Creates or updates a Markdown file on disk."
  ],
  "failure_modes": [
   {
    "when": "The content is empty",
    "what_the_agent_sees": "An error text saying content is needed"
   }
  ],
  "default_state": "on"
 },
 {
  "id": "tool.search_memory",
  "title": "Search notes",
  "summary": "Keyword search over notes. A path limits it to one note.",
  "status": "merged",
  "since": "2026-09-02",
  "see_also": [
   "group.memory"
  ],
  "search_terms": [
   "search_memory",
   "search notes"
  ],
  "name": "search_memory",
  "group": "memory",
  "description": "Looks for words in global notes, session notes or both and returns short excerpts. With a path it returns the whole note.",
  "parameters": [
   {
    "name": "query",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "Words to look for.",
    "limits": null
   },
   {
    "name": "scope",
    "type": "string",
    "required": false,
    "default": "both",
    "meaning": "Where the note lives: global (all chats) or session (this chat).",
    "limits": "One of: global, session, both."
   },
   {
    "name": "path",
    "type": "string",
    "required": false,
    "default": null,
    "meaning": "Path relative to the project, such as vault/note.md.",
    "limits": null
   }
  ],
  "returns": "Matching excerpts, about 25 lines each.",
  "example": {
   "synthetic": true,
   "call": {
    "query": "demo"
   },
   "result": "global/deploy-notes.md: ...port 8080 is used by the demo..."
  },
  "risk": "none",
  "needs_approval": "never",
  "approval_rule": "Read only.",
  "allowed_in_scheduled_jobs": true,
  "side_effects": [
   "none"
  ],
  "failure_modes": [
   {
    "when": "The path leaves the memory folder",
    "what_the_agent_sees": "The path is rejected"
   }
  ],
  "default_state": "on"
 },
