 {
  "id": "tool.vector_search",
  "title": "Meaning-based search",
  "summary": "Semantic search over notes. Falls back to keyword search.",
  "status": "merged",
  "since": "2026-09-02",
  "see_also": [
   "group.memory"
  ],
  "search_terms": [
   "vector_search",
   "meaning-based search"
  ],
  "name": "vector_search",
  "group": "memory",
  "description": "Uses Google embeddings when a Google key is set. Otherwise it searches by keyword and says so.",
  "parameters": [
   {
    "name": "query",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "Words to look for.",
    "limits": null
   },
   {
    "name": "limit",
    "type": "integer",
    "required": false,
    "default": 5,
    "meaning": "Maximum number of results.",
    "limits": null
   }
  ],
  "returns": "Ranked matches.",
  "example": {
   "synthetic": true,
   "call": {
    "query": "demo"
   },
   "result": "1. global/deploy-notes.md (score 0.82)"
  },
  "risk": "low",
  "needs_approval": "never",
  "approval_rule": "Read only. Sends note text to Google when embeddings are on.",
  "allowed_in_scheduled_jobs": true,
  "side_effects": [
   "Sends text to the embedding service",
   "Writes embedding files in the background."
  ],
  "failure_modes": [
   {
    "when": "No Google key",
    "what_the_agent_sees": "A keyword result with a note that vectors are off"
   }
  ],
  "default_state": "on"
 },
