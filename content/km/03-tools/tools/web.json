  ],
  "name": "web_search",
  "group": "web",
  "description": "Returns titles, links and short snippets.",
  "parameters": [
   {
    "name": "query",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "Words to look for.",
    "limits": null
   },
   {
    "name": "max_results",
    "type": "integer",
    "required": false,
    "default": 5,
    "meaning": "Maximum search hits.",
    "limits": null
   }
  ],
  "returns": "A list of results.",
  "example": {
