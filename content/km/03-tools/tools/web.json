 {
  "id": "tool.web_read",
  "title": "Read a web page",
  "summary": "Fetches a public page and returns its text.",
  "status": "merged",
  "since": "2026-09-02",
  "see_also": [
   "group.web"
  ],
  "search_terms": [
   "web_read",
   "read a web page"
  ],
  "name": "web_read",
  "group": "web",
  "description": "Checks every address, including redirects. Private and local addresses are refused. Credentials in the URL are refused. Text is cut to 8,000 characters. Suspicious text gets a banner.",
  "parameters": [
   {
    "name": "url",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "A public http or https address.",
    "limits": "Only public addresses. The page text is cut to 8,000 characters."
   }
  ],
  "returns": "Page text.",
  "example": {
   "synthetic": true,
   "call": {
    "url": "demo"
   },
   "result": "Example Domain. This domain is for use in examples."
  },
  "risk": "low",
  "needs_approval": "never",
  "approval_rule": "No approval. The SSRF guard blocks non-public addresses.",
  "allowed_in_scheduled_jobs": false,
  "side_effects": [
   "Makes an outbound request."
  ],
  "failure_modes": [
   {
    "when": "Private address",
    "what_the_agent_sees": "A refusal naming the reason"
   },
   {
    "when": "Non-http scheme",
    "what_the_agent_sees": "Refused"
   },
   {
    "when": "Timeout",
    "what_the_agent_sees": "An error text"
   }
  ],
  "default_state": "on"
 },
