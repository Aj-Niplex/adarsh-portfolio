  ],
  "name": "set_tool_category",
  "group": "always-on",
  "description": "The shell group is refused here. Only the operator can turn it on.",
  "parameters": [
   {
    "name": "category",
    "type": "string",
    "required": true,
    "default": null,
    "meaning": "Which group of skills or tools.",
    "limits": null
   },
   {
    "name": "enabled",
    "type": "boolean",
    "required": true,
    "default": null,
    "meaning": "True to turn the group on, false to turn it off.",
    "limits": null
   }
  ],
  "returns": "A confirmation.",
  "example": {
   "synthetic": true,
   "call": {
    "category": "demo",
    "enabled": true
   },
   "result": "Group web is now ON."
  },
  "risk": "medium",
  "needs_approval": "never",
  "approval_rule": "No approval. The shell group is operator-gated.",
  "allowed_in_scheduled_jobs": false,
  "side_effects": [
